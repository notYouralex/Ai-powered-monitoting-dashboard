# Internal HTTPS reverse-proxy template for the monitoring platform.
#
# Replace every <...> placeholder before installing this file into Nginx.
# The example intentionally does not bind to 0.0.0.0 or [::].
# Certificate and private-key material must remain outside the repository.
# Grafana and Wazuh Dashboard keep TLS enabled on loopback-only upstreams.

server {
    listen <INTERNAL_BIND_IP>:80 default_server;
    server_name _;

    return 444;
}

server {
    listen <INTERNAL_BIND_IP>:443 ssl default_server;
    server_name _;
    server_tokens off;

    ssl_certificate <TLS_CERTIFICATE_PATH>;
    ssl_certificate_key <TLS_PRIVATE_KEY_PATH>;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:MonitoringTLS:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;

    return 444;
}

server {
    listen <INTERNAL_BIND_IP>:80;
    server_name <GRAFANA_HOSTNAME>;

    return 308 https://<GRAFANA_HOSTNAME>$request_uri;
}

server {
    listen <INTERNAL_BIND_IP>:443 ssl;
    server_name <GRAFANA_HOSTNAME>;
    server_tokens off;

    ssl_certificate <TLS_CERTIFICATE_PATH>;
    ssl_certificate_key <TLS_PRIVATE_KEY_PATH>;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:MonitoringTLS:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location /api/live/ {
        proxy_pass https://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_ssl_name localhost;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate <GRAFANA_UPSTREAM_CA_PATH>;
        proxy_ssl_verify_depth 2;
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass https://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_ssl_name localhost;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate <GRAFANA_UPSTREAM_CA_PATH>;
        proxy_ssl_verify_depth 2;
    }
}

server {
    listen <INTERNAL_BIND_IP>:80;
    server_name <APP_HOSTNAME>;

    return 308 https://<APP_HOSTNAME>$request_uri;
}

server {
    listen <INTERNAL_BIND_IP>:443 ssl;
    server_name <APP_HOSTNAME>;
    server_tokens off;

    ssl_certificate <TLS_CERTIFICATE_PATH>;
    ssl_certificate_key <TLS_PRIVATE_KEY_PATH>;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:MonitoringTLS:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:<APP_PORT>;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}

server {
    listen <INTERNAL_BIND_IP>:80;
    server_name <WAZUH_DASHBOARD_HOSTNAME>;

    return 308 https://<WAZUH_DASHBOARD_HOSTNAME>$request_uri;
}

server {
    listen <INTERNAL_BIND_IP>:443 ssl;
    server_name <WAZUH_DASHBOARD_HOSTNAME>;
    server_tokens off;

    ssl_certificate <TLS_CERTIFICATE_PATH>;
    ssl_certificate_key <TLS_PRIVATE_KEY_PATH>;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:MonitoringTLS:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass https://127.0.0.1:5601;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_ssl_name 127.0.0.1;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate <WAZUH_DASHBOARD_CA_PATH>;
        proxy_ssl_verify_depth 2;
        proxy_read_timeout 120s;
    }
}
