{
  "id": null,
  "uid": "monitoring-ai-summary",
  "title": "AI Monitoring Summary",
  "__inputs": [
    {
      "name": "DS_MONITORING_API",
      "label": "Monitoring API",
      "description": "",
      "type": "datasource",
      "pluginId": "yesoreyeram-infinity-datasource",
      "pluginName": "Infinity"
    }
  ],
  "tags": [
    "monitoring",
    "ai",
    "summary"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5m",
      "10m",
      "15m",
      "30m"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Executive AI Summary",
      "description": "AI summary of bounded normalized adverse signals across all four monitoring sources.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_MONITORING_API}"
      },
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 6},
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {"type": "auto"},
            "footer": {"reducers": []},
            "inspect": false,
            "wrapText": true
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Summary"},
            "properties": [{"id": "custom.minWidth", "value": 350}]
          },
          {
            "matcher": {"id": "byName", "scope": "series", "options": "Confidence"},
            "properties": [
              {"id": "custom.width", "value": 120},
              {"id": "custom.align", "value": "center"},
              {"id": "custom.cellOptions", "value": {"mode": "gradient", "type": "color-background"}},
              {"id": "mappings", "value": [{"options": {"high": {"color": "green", "index": 0, "text": "High"}, "medium": {"color": "yellow", "index": 1, "text": "Medium"}, "low": {"color": "red", "index": 2, "text": "Low"}}, "type": "value"}]}
            ]
          }
        ]
      },
      "options": {"cellHeight": "lg", "enablePagination": false, "showHeader": true},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "${DS_MONITORING_API}"},
          "columns": [
            {"selector": "summary", "text": "Summary", "type": "string"},
            {"selector": "confidence", "text": "Confidence", "type": "string"}
          ],
          "format": "table",
          "parser": "backend",
          "root_selector": "$append([], $.executive)",
          "source": "url",
          "type": "json",
          "url": "/api/ai/insights/dashboard?from=${__from:date:iso}&to=${__to:date:iso}",
          "url_options": {"data": "", "method": "GET"}
        }
      ],
      "pluginVersion": "13.1.1"
    },
