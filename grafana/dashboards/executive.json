      "title": "Overall Health",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_MONITORING_API}"
      },
      "description": "Percentage of the four canonical integrations currently reporting a healthy status.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "mappings": [],
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_MONITORING_API}"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/api/dashboard/executive?from=${__from:date:iso}&to=${__to:date:iso}",
          "url_options": {
            "method": "GET",
            "data": ""
