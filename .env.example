APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-secret
APP_PORT=8000
POSTGRES_DB=monitoring
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST_PORT=55432
DATABASE_URL=postgresql+psycopg://monitoring:replace-with-a-strong-database-password@postgresql:5432/monitoring
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
SESSION_REFRESH_SECONDS=60
LOGIN_WINDOW_SECONDS=300
LOGIN_MAX_FAILURES=5
COOKIE_SECURE=false

GRAFANA_API_TOKEN=replace-with-a-random-token-of-at-least-32-characters

AI_ENABLED=false
AI_PROVIDER=ollama
AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_SUMMARY_MODEL=gemma3:1b-it-qat
AI_INVESTIGATION_MODEL=qwen3:1.7b
AI_CONTEXT_SIZE=1024
AI_MAX_OUTPUT_TOKENS=256
AI_TIMEOUT_SECONDS=120
AI_KEEP_ALIVE_SECONDS=0
AI_SUMMARY_CACHE_SECONDS=300

WAZUH_BASE_URL=
WAZUH_USERNAME=
WAZUH_PASSWORD=
WAZUH_VERIFY_TLS=true
WAZUH_CA_BUNDLE=
WAZUH_TIMEOUT_SECONDS=10
WAZUH_INDEXER_BASE_URL=
WAZUH_INDEXER_USERNAME=
WAZUH_INDEXER_PASSWORD=
WAZUH_INDEXER_VERIFY_TLS=true
WAZUH_INDEXER_CA_BUNDLE=
WAZUH_INDEXER_TIMEOUT_SECONDS=10

ZABBIX_BASE_URL=
ZABBIX_API_TOKEN=
ZABBIX_VERIFY_TLS=true
ZABBIX_CA_BUNDLE=
ZABBIX_TIMEOUT_SECONDS=10

SNIPE_IT_BASE_URL=
SNIPE_IT_API_TOKEN=
SNIPE_IT_VERIFY_TLS=true
SNIPE_IT_CA_BUNDLE=
SNIPE_IT_TIMEOUT_SECONDS=10
SNIPE_IT_SYNC_INTERVAL_SECONDS=900

FRESHSERVICE_BASE_URL=
FRESHSERVICE_API_KEY=
FRESHSERVICE_VERIFY_TLS=true
FRESHSERVICE_CA_BUNDLE=
FRESHSERVICE_TIMEOUT_SECONDS=10
FRESHSERVICE_SYNC_INTERVAL_SECONDS=600
